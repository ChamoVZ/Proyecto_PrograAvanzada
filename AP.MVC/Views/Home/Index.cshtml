@{
    ViewBag.Title = "Entrenamiento Mental";
}

<div class="mx-hero text-center py-5 mb-5">
    <span class="mx-hero-op" style="font-size:200px; top:-50px; left:-30px;">&#247;</span>
    <span class="mx-hero-op" style="font-size:150px; bottom:-40px; right:0;">&times;</span>
    <span class="mx-hero-op" style="font-size:120px; top:20px; right:60px;">+</span>
    <div class="container py-5">
        <h1 class="display-3 fw-bold mb-3 mx-hero-title">MathemaX</h1>
        <p class="lead mb-4 mx-hero-lead">
            Despierte su agilidad mental con los retos matemáticos más desafiantes.<br />
            Demuestre su destreza, acumule XP y domine los marcadores.
        </p>
        <div>
            @if (Request.IsAuthenticated)
            {
                <a href="@Url.Action("Index", "Juego")" class="btn-mx-primary btn-lg">
                    <i class="bi bi-play-circle me-2"></i>Comenzar a jugar
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="btn-mx-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                </a>
            }
        </div>
    </div>
</div>

<div class="container mb-5">
    <h2 class="text-center mb-5 mx-section-title">Modos de Juego</h2>
    <div class="row g-4">

        <!-- Operador Perdido -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 mx-mode-card position-relative">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <div class="mx-mode-icon-badge badge-op">
                            <i class="bi bi-patch-question"></i>
                        </div>
                    </div>
                    <h4 class="card-title fw-bold">
                        <a href="@Url.Action("Jugar", "OperadorPerdido")" class="stretched-link">
                            Operador Perdido
                        </a>
                    </h4>
                    <p class="card-text text-muted">
                        Descubra cuál es el operador matemático (+, -, *, /) que falta para que la ecuación tenga sentido. ¡Piense rápido!
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 mx-mode-card">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <div class="mx-mode-icon-badge badge-time">
                            <i class="bi bi-stopwatch"></i>
                        </div>
                    </div>
                    <h4 class="card-title fw-bold">
                        <a href="@Url.Action("Jugar", "Contrarreloj")" class="stretched-link">
                            Contrarreloj
                        </a>
                    </h4>
                    <p class="card-text text-muted">
                        Resuelva la mayor cantidad de retos matemáticos antes de que se acabe el tiempo. La presión está al máximo.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 mx-mode-card">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <div class="mx-mode-icon-badge badge-xp">
                            <i class="bi bi-sort-numeric-down"></i>
                        </div>
                    </div>
                    <h4 class="card-title fw-bold">
                        <a href="@Url.Action("Jugar", "SecuenciasLogicas")" class="stretched-link">
                            Secuencias Lógicas
                        </a>
                    </h4>
                    <p class="card-text text-muted">
                        Encuentre el patrón oculto en una serie de números y descubra cuál es el siguiente paso lógico.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="container mb-5">
    <div class="card shadow-sm border-0 mx-xp-card">
        <div class="card-body p-5">
            <div class="row align-items-center">
                <div class="col-md-8 text-md-start text-center mb-4 mb-md-0">
                    <h3 class="fw-bold mb-3" style="color: var(--color-academy);">Progreso y Competencia</h3>
                    <p class="mb-0" style="color: var(--color-ink-muted);">
                        Cada vez que resuelves un reto correctamente, obtienes Puntos de Experiencia (XP) basados en la
                        <strong>dificultad</strong> del problema. Entre más rápido resuelvas y más difíciles sean los retos,
                        más alto escalarás en nuestros <strong>Marcadores Globales</strong>. ¿Tienes lo necesario para ser el número uno?
                    </p>
                </div>
                <div class="col-md-4 text-center">
                    <i class="bi bi-trophy mx-xp-icon"></i>
                </div>
            </div>
        </div>
    </div>
</div>
