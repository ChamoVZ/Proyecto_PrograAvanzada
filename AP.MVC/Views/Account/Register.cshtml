@model AP.MVC.Models.RegisterViewModel
@{
    ViewBag.Title = "Registrarse";
}

<main aria-labelledby="title" class="auth-stage">
    <div class="auth-side">
        <div class="auth-op op1">&#247;</div>
        <div class="auth-op op2">&times;</div>
        <div class="auth-op op3">+</div>
        <p class="auth-wordmark">Mathema<span>X</span></p>
        <p class="auth-tagline">Cree su cuenta y empiece a sumar puntos, subir de nivel y desbloquear los 3 modos de juego.</p>
        <div class="auth-modes">
            <div class="auth-mode mode-op">
                <div class="auth-mode-badge">?=</div>
                <div>
                    <div class="auth-mode-name">Operador perdido</div>
                    <div class="auth-mode-desc">Encuentre el signo que falta</div>
                </div>
            </div>
            <div class="auth-mode mode-time">
                <div class="auth-mode-badge">00:0</div>
                <div>
                    <div class="auth-mode-name">Contrarreloj</div>
                    <div class="auth-mode-desc">Resuelva antes de que se acabe el tiempo</div>
                </div>
            </div>
            <div class="auth-mode mode-xp">
                <div class="auth-mode-badge">&darr;9</div>
                <div>
                    <div class="auth-mode-name">Secuencias lógicas</div>
                    <div class="auth-mode-desc">Encuentre el patrón oculto</div>
                </div>
            </div>
        </div>
    </div>

    <div class="auth-panel">
        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            <h2 id="title">@ViewBag.Title</h2>
            <p class="auth-sub">Cree una cuenta nueva para empezar a jugar y guardar su progreso.</p>

            @Html.ValidationSummary(true, "", new { @class = "auth-error" })

            <div class="auth-field">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "nombre@correo.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="auth-field">
                @Html.LabelFor(m => m.Password)
                <div class="auth-password-control">
                    @Html.PasswordFor(m => m.Password, new
                    {
                        @class = "form-control",
                        placeholder = "••••••••",
                        autocomplete = "new-password",
                        aria_describedby = "password-requisitos"
                    })
                    <button type="button"
                            class="auth-password-toggle"
                            data-password-target="Password"
                            aria-controls="Password"
                            aria-pressed="false">
                        Mostrar
                    </button>
                </div>
                <small id="password-requisitos" class="auth-password-help">
                    Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.
                </small>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="auth-field">
                @Html.LabelFor(m => m.ConfirmPassword)
                <div class="auth-password-control">
                    @Html.PasswordFor(m => m.ConfirmPassword, new
                    {
                        @class = "form-control",
                        placeholder = "••••••••",
                        autocomplete = "new-password"
                    })
                    <button type="button"
                            class="auth-password-toggle"
                            data-password-target="ConfirmPassword"
                            aria-controls="ConfirmPassword"
                            aria-pressed="false">
                        Mostrar
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <input type="submit" value="Registrarse" class="auth-btn" />

            <p class="auth-footer-link">
                ¿Ya tiene una cuenta? @Html.ActionLink("Inicie sesión", "Login")
            </p>
        }
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            document.querySelectorAll("[data-password-target]").forEach(function (boton) {
                boton.addEventListener("click", function () {
                    var campo = document.getElementById(boton.dataset.passwordTarget);
                    var mostrar = campo.type === "password";
                    campo.type = mostrar ? "text" : "password";
                    boton.textContent = mostrar ? "Ocultar" : "Mostrar";
                    boton.setAttribute("aria-pressed", mostrar ? "true" : "false");
                });
            });
        })();
    </script>
}
