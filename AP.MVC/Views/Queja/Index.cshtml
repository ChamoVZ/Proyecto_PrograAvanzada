@model IEnumerable<AP.Models.Buzon.QuejaViewModel>

@{
    ViewBag.Title = "Buzón de Quejas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Buzón de Quejas</h2>
        <a href="@Url.Action("Create")" class="btn-mx-primary"><i class="bi bi-plus-circle me-2"></i>Nueva Queja</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Atención:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <h4 class="card-title fw-bold" style="color: var(--color-ink);">@item.Asunto</h4>
                                    <h6 class="card-subtitle mb-3 text-muted">
                                        <i class="bi bi-person-circle me-1"></i> @item.NombreAutor &bull;
                                        <i class="bi bi-tag me-1"></i> @item.NombreCategoria &bull;
                                        <i class="bi bi-calendar-event me-1"></i> @item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </h6>
                                </div>
                                <span class="badge rounded-pill" style="background-color: var(--color-academy);">@item.NombreEstado</span>
                            </div>
                            <p class="card-text">
                                @item.Descripcion
                            </p>
                        </div>
                        @if (User.IsInRole("Admin") || User.IsInRole("Support") || item.PuedeEditar || item.PuedeEliminar)
                        {
                            <div class="card-footer bg-white border-top-0 d-flex justify-content-end align-items-center gap-2 pb-3">
                                @if (User.IsInRole("Admin") || User.IsInRole("Support"))
                                {
                                    using (Html.BeginForm("CambiarEstado", "Queja", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.QuejaId" />
                                        <select name="estado" class="form-select form-select-sm" style="width:auto;">
                                            <option value="1" selected="@(item.Estado == 1)">Pendiente</option>
                                            <option value="2" selected="@(item.Estado == 2)">En revisión</option>
                                            <option value="3" selected="@(item.Estado == 3)">Resuelta</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Actualizar estado</button>
                                    }
                                }

                                @if (item.PuedeEditar)
                                {
                                    <a href="@Url.Action("Edit", new { id = item.QuejaId })" class="btn btn-sm btn-outline-secondary">Editar</a>
                                }

                                @if (item.PuedeEliminar)
                                {
                                    using (Html.BeginForm("Delete", "Queja", FormMethod.Post, new { onsubmit = "return confirm('¿Está seguro que desea eliminar esta queja?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.QuejaId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-envelope-paper text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted">Aún no hay quejas registradas.</h4>
                <p class="text-muted">Registra una queja o sugerencia para que el equipo pueda revisarla.</p>
            </div>
        }
    </div>
</div>
