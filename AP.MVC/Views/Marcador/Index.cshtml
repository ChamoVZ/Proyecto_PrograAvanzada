@model AP.Models.Juegos.MarcadoresPaginaViewModel
@using AP.Models.Juegos

@{
    ViewBag.Title = "Marcadores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Marcadores Globales</h2>
        <a href="@Url.Action("Index", "Juego")" class="btn-mx-primary"><i class="bi bi-controller me-2"></i>Jugar</a>
    </div>

    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body">
            @if (Model != null && Model.Ranking.Elementos.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Jugador</th>
                                <th scope="col" class="text-end">XP total</th>
                                <th scope="col" class="text-end">Partidas</th>
                                <th scope="col" class="text-end">Aciertos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Ranking.Elementos)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Posicion</td>
                                    <td><i class="bi bi-person-circle me-1"></i> @item.NombreJugador</td>
                                    <td class="text-end">@item.ExperienciaTotal</td>
                                    <td class="text-end">@item.PartidasJugadas</td>
                                    <td class="text-end">@item.Aciertos</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-trophy text-muted" style="font-size: 4rem;"></i>
                    <h4 class="mt-3 text-muted">Todavía nadie ha jugado.</h4>
                    <p class="text-muted">Sea el primero en resolver un reto y aparecer en el marcador.</p>
                </div>
            }
            @Html.Partial("_Paginacion", Model.Ranking, new ViewDataDictionary
            {
                { "ParametroPagina", "paginaRanking" },
                { "ParametroTamano", "tamanoRanking" }
            })
        </div>
    </div>

    <h3 class="mb-3">Su historial</h3>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Marcador", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <input type="hidden" name="paginaRanking" value="@Model.Ranking.PaginaActual" />
                <input type="hidden" name="tamanoRanking" value="@Model.Ranking.TamanoPagina" />
                <input type="hidden" name="tamanoHistorial" value="@Model.Historial.TamanoPagina" />

                <div class="col-md-3">
                    @Html.LabelFor(m => m.Filtros.Resultado, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Filtros.Resultado, new[]
                    {
                        new SelectListItem { Text = "Todos", Value = "" },
                        new SelectListItem { Text = "Solo acertados", Value = "true" },
                        new SelectListItem { Text = "Solo fallados", Value = "false" }
                    }, new { @class = "form-select" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.Filtros.Modo, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Filtros.Modo, new[]
                    {
                        new SelectListItem { Text = "Todos", Value = "" },
                        new SelectListItem { Text = "Operador Perdido", Value = "1" },
                        new SelectListItem { Text = "Contrarreloj", Value = "2" },
                        new SelectListItem { Text = "Secuencias Lógicas", Value = "3" }
                    }, new { @class = "form-select" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.Filtros.Desde, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Filtros.Desde, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.Filtros.Hasta, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Filtros.Hasta, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a href="@Url.Action("Index", new { tamanoRanking = Model.Ranking.TamanoPagina, tamanoHistorial = Model.Historial.TamanoPagina })" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Historial.Elementos.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Reto</th>
                                <th scope="col">Modo</th>
                                <th scope="col">Resultado</th>
                                <th scope="col" class="text-end">Tiempo (s)</th>
                                <th scope="col" class="text-end">XP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var partida in Model.Historial.Elementos)
                            {
                                <tr>
                                    <td>@partida.FechaJuego.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@partida.TituloReto</td>
                                    <td>@partida.Modo</td>
                                    <td>
                                        @if (partida.Acertado)
                                        {
                                            <span class="badge rounded-pill bg-success">Acertado</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary">Fallado</span>
                                        }
                                    </td>
                                    <td class="text-end">@partida.TiempoEmpleadoSegundos</td>
                                    <td class="text-end">@partida.XpGanado</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0 text-center py-4">No hay partidas que coincidan con los filtros.</p>
            }
            @Html.Partial("_Paginacion", Model.Historial, new ViewDataDictionary
            {
                { "ParametroPagina", "paginaHistorial" },
                { "ParametroTamano", "tamanoHistorial" }
            })
        </div>
    </div>
</div>
