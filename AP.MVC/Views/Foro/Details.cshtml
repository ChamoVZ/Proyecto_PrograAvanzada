@model AP.Models.Comunidad.PublicacionViewModel

@{
    ViewBag.Title = "Detalle de Publicación";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="card-title fw-bold mx-card-title">@Model.Titulo</h3>
                    <h6 class="card-subtitle mb-3 text-muted">
                        <i class="bi bi-person-circle me-1"></i> @Model.NombreAutor &bull;
                        <i class="bi bi-calendar-event me-1"></i> @Model.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                    </h6>
                    <hr />
                    <p class="card-text">@Model.Contenido</p>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-end gap-2 pb-3">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
                    @if (Model.PuedeModificar)
                    {
                        <a href="@Url.Action("Edit", new { id = Model.PublicacionId })" class="btn btn-outline-primary">Editar</a>
                        using (Html.BeginForm("Delete", "Foro", new { id = Model.PublicacionId }, FormMethod.Post, new { onsubmit = "return confirm('¿Eliminar esta publicación?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">Eliminar</button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
