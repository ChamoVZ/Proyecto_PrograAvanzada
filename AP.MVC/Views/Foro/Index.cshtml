@model IEnumerable<AP.Models.Comunidad.PublicacionViewModel>

@{
    ViewBag.Title = "Foro de la Comunidad";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Foro de la Comunidad</h2>
        <a href="@Url.Action("Create")" class="btn-mx-primary"><i class="bi bi-pencil-square me-2"></i>Nueva Publicaci&oacute;n</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Atenci&oacute;n:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h4 class="card-title fw-bold" style="color: var(--color-ink);">@item.Titulo</h4>
                            <h6 class="card-subtitle mb-3 text-muted">
                                <i class="bi bi-person-circle me-1"></i> @item.NombreAutor &bull; 
                                <i class="bi bi-calendar-event me-1"></i> @item.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                            </h6>
                            <p class="card-text">
                                @item.Contenido
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-end pb-3">
                            <!-- TODO: Avance 3 - Botones para Detalle, Editar y Eliminar -->
                            <button class="btn btn-sm btn-outline-secondary disabled" title="Disponible en el Avance 3">Ver Detalles</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-chat-square-text text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted">A&uacute;n no hay publicaciones en el foro.</h4>
                <p class="text-muted">S&eacute; el primero en compartir algo con la comunidad.</p>
            </div>
        }
    </div>
</div>
