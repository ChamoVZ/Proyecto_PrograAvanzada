@model IEnumerable<AP.Models.Comunidad.PublicacionViewModel>
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Foro de la Comunidad";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Foro de la Comunidad</h2>
        <a href="@Url.Action("Create")" class="btn-mx-primary"><i class="bi bi-pencil-square me-2"></i>Nueva Publicación</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Atención:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h4 class="card-title fw-bold" style="color: var(--color-ink);">@item.Titulo</h4>
                            <h6 class="card-subtitle mb-3 text-muted">
                                <i class="bi bi-person-circle me-1"></i> @item.NombreAutor &bull; 
                                <i class="bi bi-calendar-event me-1"></i> @item.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                            </h6>
                            <p class="card-text">
                                @item.Contenido
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-end gap-2 pb-3">
                            <a href="@Url.Action("Details", new { id = item.PublicacionId })" class="btn btn-sm btn-outline-secondary">Ver Detalles</a>
                            @if (item.UsuarioId == User.Identity.GetUserId() || User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Edit", new { id = item.PublicacionId })" class="btn btn-sm btn-outline-primary">Editar</a>
                                using (Html.BeginForm("Delete", "Foro", new { id = item.PublicacionId }, FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('¿Eliminar esta publicación?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-chat-square-text text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted">Aún no hay publicaciones en el foro.</h4>
                <p class="text-muted">Sé el primero en compartir algo con la comunidad.</p>
            </div>
        }
    </div>
</div>
