@model AP.Models.Comunidad.PublicacionViewModel

@{
    ViewBag.Title = "Editar Publicación";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">Editar Publicación</h3>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <strong>Atención:</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Edit", "Foro", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.PublicacionId)
                        @Html.HiddenFor(model => model.Activo)

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Titulo, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.Contenido, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(model => model.Contenido, new { @class = "form-control", rows = 6 })
                            @Html.ValidationMessageFor(model => model.Contenido, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn-mx-primary">Guardar cambios</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
