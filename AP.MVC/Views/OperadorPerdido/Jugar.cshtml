@model AP.Models.Juegos.RetoJuegoViewModel

@{
    ViewBag.Title = "Operador Perdido";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">Operador Perdido</h3>
                    <small class="text-muted">Dificultad @Model.Dificultad &middot; Tiempo l&iacute;mite: @Model.TiempoLimiteSegundos s</small>
                </div>
                <div class="card-body p-4 text-center">

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <p class="fs-3 fw-bold my-4">@Model.Enunciado</p>

                    @using (Html.BeginForm("Responder", "OperadorPerdido", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.RetoId)
                        @Html.HiddenFor(m => m.HoraInicioTicks)

                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            @foreach (var operador in new[] { "+", "-", "*", "/" })
                            {
                                <button type="submit" name="RespuestaUsuario" value="@operador" class="btn btn-outline-primary btn-lg px-4">
                                    @operador
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>