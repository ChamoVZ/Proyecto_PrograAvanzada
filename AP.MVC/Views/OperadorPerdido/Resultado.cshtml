@model AP.Models.Juegos.ResultadoJuegoViewModel

@{
    ViewBag.Title = "Resultado";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">

                    @if (Model.Acertado)
                    {
                        <h3 class="text-success">&iexcl;Correcto!</h3>
                        <p class="fs-4">Ganaste <strong>+@Model.XpGanado XP</strong></p>
                    }
                    else
                    {
                        <h3 class="text-danger">Incorrecto</h3>
                        <p>La respuesta correcta era: <strong>@Model.RespuestaCorrecta</strong></p>
                    }

                    @if (Model.SubioDeNivel)
                    {
                        <div class="alert alert-success mt-3">
                            &iexcl;Subiste a nivel @Model.Nivel!
                        </div>
                    }

                    <hr />

                    <p class="text-muted mb-0">
                        Nivel actual: <strong>@Model.Nivel</strong> &middot;
                        XP total: <strong>@Model.ExperienciaTotal</strong>
                    </p>

                    <div class="mt-4">
                        <a href="@Url.Action("Jugar", "OperadorPerdido")" class="btn-mx-primary">Jugar otra vez</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>