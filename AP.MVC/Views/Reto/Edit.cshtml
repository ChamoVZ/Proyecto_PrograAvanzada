@model AP.Models.Juegos.RetoViewModel

@{
    ViewBag.Title = "Editar Reto";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h3 class="card-title mb-0">Editar Reto</h3>
        </div>
        <div class="card-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <strong>Atención:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @using (Html.BeginForm("Edit", "Reto", FormMethod.Post))
            {
                @Html.HiddenFor(m => m.RetoId)
                @Html.Partial("_FormReto", Model)
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
