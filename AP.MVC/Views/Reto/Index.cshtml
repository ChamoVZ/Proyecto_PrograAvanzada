@model IEnumerable<AP.Models.Juegos.RetoViewModel>

@{
    ViewBag.Title = "Mantenimiento de Retos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mantenimiento de Retos</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">Nuevo Reto</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Atención:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Modo</th>
                    <th>Dificultad</th>
                    <th>Tiempo Límite</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                            <td>
                                <!-- Mapeo simple del int al string del Enum -->
                                @(((AP.Data.Entities.ModoJuego)item.Modo).ToString())
                            </td>
                            <td>@item.Dificultad</td>
                            <td>@item.TiempoLimiteSegundos seg</td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Edit", new { id = item.RetoId })" class="btn btn-sm btn-outline-secondary">Editar</a>
                                
                                <!-- El reto no se borra: se desactiva para no perder las partidas jugadas -->
                                <form action="@Url.Action("Delete", new { id = item.RetoId })" method="post" style="display:inline;" onsubmit="return confirm('¿Está seguro que desea desactivar este reto?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">No hay retos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
